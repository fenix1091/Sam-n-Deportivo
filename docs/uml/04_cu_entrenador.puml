@startuml
!include _estilo.iuml
title Casos de uso — Entrenador
left to right direction
actor "Entrenador" as T
rectangle "Samán Deportivo" {
  usecase "CU-02 Iniciar sesión" as CU02
  usecase "CU-03 Gestionar perfil" as CU03
  usecase "CU-13 Consultar estudiantes\ninscritos en su disciplina" as CU13
  usecase "CU-14 Registrar asistencia\ndel entrenamiento" as CU14
  usecase "CU-15 Consultar historial\nde asistencia" as CU15
  usecase "Exportar lista\nde inscritos" as EXP
}
T --> CU02
T --> CU03
T --> CU13
T --> CU14
T --> CU15
CU14 ..> CU13 : <<include>>
EXP .> CU13 : <<extend>>
@enduml
