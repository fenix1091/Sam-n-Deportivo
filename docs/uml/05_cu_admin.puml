@startuml
!include _estilo.iuml
title Casos de uso — Administrador
left to right direction
actor "Administrador" as A
rectangle "Samán Deportivo" {
  usecase "CU-02 Iniciar sesión" as CU02
  usecase "CU-16 Gestionar deportes\n(alta, modificación, baja)" as CU16
  usecase "Definir cupo máximo" as CUP
  usecase "CU-17 Asignar entrenador\na un deporte" as CU17
  usecase "CU-18 Configurar horarios\nde entrenamiento" as CU18
  usecase "CU-19 Registrar entrenador" as CU19
  usecase "CU-20 Ver dashboard\nde estadísticas" as CU20
  usecase "Exportar reporte" as REP
}
A --> CU02
A --> CU16
A --> CU17
A --> CU18
A --> CU19
A --> CU20
CU16 ..> CUP : <<include>>
CU17 .> CU19 : <<extend>>\n(entrenador no existe)
REP .> CU20 : <<extend>>
@enduml
